# Display name shown in the page title and sidebar.
APP_NAME=见微
# offline = market data only; api = enable model analysis
APP_MODE=offline
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional: used when the primary returns 402, 429, 5xx or times out
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=deepseek-v4.1-flash

# Optional: Exa search for news (https://exa.ai)
EXA_API_KEY=

# FastAPI web app. Data dir defaults to ./var. Set COOKIE_SECURE=0 only for local http testing.
JIANWEI_DATA=
COOKIE_SECURE=1
