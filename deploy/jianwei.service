# Copy to /etc/systemd/system/jianwei.service, replace USER and /home/USER/projects/ai-investment-research, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now jianwei
[Unit]
Description=Jianwei web server
After=network-online.target
Wants=network-online.target

[Service]
User=USER
WorkingDirectory=/home/USER/projects/ai-investment-research
ExecStart=/home/USER/projects/ai-investment-research/.venv/bin/python -m uvicorn src.web:create_app --factory --host 127.0.0.1 --port 8600
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
